{
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/sync/groner/completa/propostas", "schedule": "10 6 * * *" },
    { "path": "/api/sync/groner/completa/tarefas", "schedule": "20 6 * * *" },
    { "path": "/api/sync/groner/completa/vendas", "schedule": "30 6 * * *" },
    { "path": "/api/sync/groner/pieta", "schedule": "40 6 * * *" },
    { "path": "/api/sync/groner/solarz", "schedule": "50 6 * * *" }
  ],
  "rewrites": [
    { "source": "/.well-known/:path*", "destination": "/api/mcp-solarz?nao_oauth=1" },
    { "source": "/register", "destination": "/api/mcp-solarz?nao_oauth=1" },
    { "source": "/authorize", "destination": "/api/mcp-solarz?nao_oauth=1" },
    { "source": "/token", "destination": "/api/mcp-solarz?nao_oauth=1" },
    { "source": "/mcp/solarz", "destination": "/api/mcp-solarz" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/api/:path*", "destination": "/api" }
  ]
}
