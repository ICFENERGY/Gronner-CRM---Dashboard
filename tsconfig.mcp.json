{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./mcp-server/dist",
    "rootDir": "./mcp-server/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["mcp-server/src/index.ts"],
  "exclude": ["node_modules", "dist", "mcp-server/dist"]
}
