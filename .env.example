# Token de integração do Groner CRM (Conta/GerarToken - validade longa).
# NUNCA use o prefixo VITE_ aqui: variáveis VITE_ vão para o bundle do navegador
# e exporiam este token, que tem permissão de Administrador/Financeiro.
GRONER_TOKEN=

# Subdomínio do tenant, ex: https://<tenant>.api.groner.app
GRONER_TENANT=ityou

# Porta do servidor backend (proxy)
PORT=3001
