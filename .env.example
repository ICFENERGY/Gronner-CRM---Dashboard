# Token de integração do Groner CRM (Conta/GerarToken - validade longa).
# NUNCA use o prefixo VITE_ aqui: variáveis VITE_ vão para o bundle do navegador
# e exporiam este token, que tem permissão de Administrador/Financeiro.
GRONER_TOKEN=

# Subdomínio do tenant, ex: https://<tenant>.api.groner.app
GRONER_TENANT=ityou

# Porta do servidor backend (proxy)
PORT=3001

# Usuário de API da SolarZ Monitoramento (gerado em Configurações > Usuário de API).
# Também não deve ter prefixo VITE_ — nunca deve chegar ao navegador.
SOLARZ_USER=
SOLARZ_PASSWORD=

# Credenciais da API Pieta (plataforma PIEP), Basic Auth. Ainda pendente —
# preencha e reinicie o servidor quando a Pieta gerar o usuário/senha.
PIETA_USER=
PIETA_PASSWORD=

# --- MCP Server (mcp-server/, integrações remotas como ChatGPT) ---
# Usa o mesmo GRONER_TENANT acima. Para autenticação, escolha uma opção:
# Opção 1: reaproveita o GRONER_TOKEN acima (recomendado).
# Opção 2: login automático por e-mail/senha (o servidor gerencia o token).
GRONER_EMAIL=
GRONER_SENHA=
