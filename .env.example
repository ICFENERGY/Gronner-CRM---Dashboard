# Subdomínio do seu tenant no Groner (ex: minhaempresa → minhaempresa.api.groner.app)
GRONER_TENANT=seusubdominio

# Opção 1: Token de longa duração (500 dias) — recomendado para integrações
# Gere pelo endpoint POST /Conta/GerarToken ou pelo painel do Groner
GRONER_TOKEN=seu_token_aqui

# Opção 2: Credenciais para login automático (o servidor gerencia o token)
GRONER_EMAIL=usuario@empresa.com
GRONER_SENHA=suasenha
