            "index": 0
          }
        ]
      ]
    },
    "Buscar detalhe do projeto": {
      "main": [
        [
          {
            "node": "Buscar campos personalizados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar campos personalizados": {
