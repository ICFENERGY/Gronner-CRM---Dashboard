{
  "name": "Groner Dashboard - Sincronizar Projetos",
  "nodes": [
    {
      "id": "90c495e3-81a5-4bd0-9b53-2d83d8088ce3",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "734b4dd5-1c18-4c92-b2ee-1fdd024fe548",
      "name": "Agenda 08h e 18h (aguarda ativação)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ],
      "disabled": true,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8,18 * * *"
            }
          ]
        }
      },
      "notes": "Horários escalonados em 5 minutos para não sobrecarregar os workers nem a API do Groner."
    },
    {
      "id": "84525b37-5b66-4483-8c0b-1e817108abf8",
      "name": "Entidade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: {\"slug\":\"projetos\",\"recurso\":\"Projeto\"} }]"
      }
    },
    {
      "id": "341f94f0-13d4-4b34-9d70-f5d6a1cc4244",
      "name": "Configuração",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const entidade = $input.first().json\nconst agora = new Date()\nreturn [{ json: {\n  runId: entidade.slug + '-' + agora.toISOString().replace(/[-:.]/g, ''),\n  runStartedAt: agora.toISOString(),\n  slug: entidade.slug,\n  recurso: entidade.recurso,\n  tamanhoPagina: entidade.slug === 'propostas' ? 100 : 500,\n  tamanhoLote: 50,\n  detalharProjeto: entidade.slug === 'projetos',\n} }]"
      }
    },
    {
      "id": "4d7e37ae-2bf3-42c5-bf65-f868de371d60",
      "name": "Consultar total",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        90
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "GronerZap - Groner API leitura"
        }
      },
      "parameters": {
        "url": "={{ 'https://{tenant}.api.groner.app/api/' + $json.recurso }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "pageNumber",
              "value": "1"
            },
            {
              "name": "pageSize",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "7c6ef981-8552-49e0-b6d9-15ba1e6bdf95",
      "name": "Gerar páginas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Configuração').first().json\nconst corpo = $input.first().json\nconst dados = corpo && (corpo.Content || corpo.content || corpo)\nconst total = Number(dados && (dados.totalItems ?? dados.totalCount ?? dados.total))\nif (!Number.isInteger(total) || total < 0) throw new Error('Groner não informou um total válido')\nconst paginas = Math.max(1, Math.ceil(total / cfg.tamanhoPagina))\nif (paginas > 500) throw new Error('Limite de 500 páginas excedido')\nreturn Array.from({ length: paginas }, (_, i) => ({ json: {\n  runId: cfg.runId,\n  runStartedAt: cfg.runStartedAt,\n  slug: cfg.slug,\n  recurso: cfg.recurso,\n  pageNumber: i + 1,\n  pageSize: cfg.tamanhoPagina,\n  totalEsperado: total,\n  tamanhoLote: cfg.tamanhoLote,\n  batchCount: Math.max(1, Math.ceil(total / cfg.tamanhoLote)),\n  detalharProjeto: cfg.detalharProjeto,\n} }))"
      }
    },
    {
      "id": "cfd5d077-98cd-4cea-99a7-279bace54b17",
      "name": "Buscar páginas separadamente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1200,
        90
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "{dashboardPaginaWorkflowId}",
          "mode": "id",
          "cachedResultName": "Groner Dashboard - Buscar uma página"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "e6c8849e-a334-41da-80ef-659858b8b61c",
      "name": "Somar e validar paginas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Gerar páginas').first().json\nconst paginas = $input.all().map((item) => item.json)\nif (!paginas.length) throw new Error('Nenhuma página foi processada')\nconst totais = new Set(paginas.map((pagina) => Number(pagina.totalItems)))\nconst esperado = Number(cfg.totalEsperado)\nif (totais.size !== 1 || Number([...totais][0]) !== esperado) throw new Error('O total do Groner mudou durante a paginação')\nconst received = paginas.reduce((total, pagina) => total + Number(pagina.received || 0), 0)\nif (received !== esperado) throw new Error('Carga incompleta: recebidos ' + received + ' de ' + esperado)\nreturn [{ json: { runId: cfg.runId, runStartedAt: cfg.runStartedAt, entity: cfg.slug, batchCount: cfg.batchCount, expectedTotal: cfg.totalEsperado, inserted: paginas.reduce((t, p) => t + Number(p.inserted || 0), 0), updated: paginas.reduce((t, p) => t + Number(p.updated || 0), 0), unchanged: paginas.reduce((t, p) => t + Number(p.unchanged || 0), 0) } }]"
      }
    },
    {
      "id": "cfede8d9-fbb5-4ab1-89d2-6a670ef86d8e",
      "name": "Finalizar carga completa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        90
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Groner Dashboard - Sync"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://groner-crm-dashboard-ten.vercel.app/api/sync/groner/' + $json.entity + '/finalize' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "notes": "Somente este passo pode marcar como removidos registros que não apareceram na carga completa."
    }
  ],
  "connections": {
    "Executar manualmente": {
      "main": [
        [
          {
            "node": "Entidade",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agenda 08h e 18h (aguarda ativação)": {
      "main": [
        [
          {
            "node": "Entidade",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Entidade": {
      "main": [
        [
          {
            "node": "Configuração",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuração": {
      "main": [
        [
          {
            "node": "Consultar total",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar total": {
      "main": [
        [
          {
            "node": "Gerar páginas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar páginas": {
      "main": [
        [
          {
            "node": "Buscar páginas separadamente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar páginas separadamente": {
      "main": [
        [
          {
            "node": "Somar e validar paginas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Somar e validar paginas": {
      "main": [
        [
          {
            "node": "Finalizar carga completa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
